{
  "name": "@natzar/client",
  "version": "0.19.0",
  "description": "Official TypeScript client for the Natzar Partner API — AI health-assistant chat, async physician consults, live video consults, prescriptions with an in-app pharmacy picker, referrals as signed PDF requisitions, non-blocking referral requests, a browser-side patient surface and physician workspace, the natzar() embed middleware with React components, and webhook signature verification.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natzar-ai/natzar-client.git"
  },
  "homepage": "https://natzar-ai.github.io/natzar-client/",
  "bugs": {
    "url": "https://github.com/natzar-ai/natzar-client/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./patient": {
      "types": "./dist/esm/patient/index.d.ts",
      "import": "./dist/esm/patient/index.js",
      "require": "./dist/cjs/patient/index.js"
    },
    "./physician": {
      "types": "./dist/esm/physician/index.d.ts",
      "import": "./dist/esm/physician/index.js",
      "require": "./dist/cjs/physician/index.js"
    },
    "./server": {
      "types": "./dist/esm/server/index.d.ts",
      "workerd": "./dist/esm/server/index.js",
      "edge-light": "./dist/esm/server/index.js",
      "deno": "./dist/esm/server/index.js",
      "bun": "./dist/esm/server/index.js",
      "node": {
        "import": "./dist/esm/server/index.js",
        "require": "./dist/cjs/server/index.js"
      },
      "browser": "./dist/esm/server/browser.js",
      "import": "./dist/esm/server/index.js",
      "require": "./dist/cjs/server/index.js"
    },
    "./react": {
      "types": "./dist/esm/react/index.d.ts",
      "import": "./dist/esm/react/index.js",
      "require": "./dist/cjs/react/index.js"
    },
    "./elements": {
      "types": "./dist/esm/elements/index.d.ts",
      "import": "./dist/esm/elements/index.js",
      "require": "./dist/cjs/elements/index.js"
    },
    "./contract": {
      "types": "./dist/esm/contract/index.d.ts",
      "import": "./dist/esm/contract/index.js",
      "require": "./dist/cjs/contract/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "sync-contract": "node scripts/sync-contract.mjs",
    "check-contract": "node scripts/sync-contract.mjs --check",
    "clean": "rm -rf dist",
    "build": "npm run check-contract && npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.build.json && node scripts/esm-extensions.mjs",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/cjs-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "tsc -p examples/tsconfig.json && tsc -p examples/tsconfig.plan-js.json",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.ts",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "zod": "^3.25.17"
  },
  "peerDependencies": {
    "livekit-client": "^2.22.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "livekit-client": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "natzar",
    "telehealth",
    "health",
    "api-client",
    "webhooks",
    "middleware",
    "react"
  ]
}
